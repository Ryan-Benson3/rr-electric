---
interface Props { title: string; description: string; path?: string; }
const { title, description, path = '/' } = Astro.props;
// TODO before launch: update `site` here and in astro.config.mjs when the real domain is connected
const site = 'https://rr-electric.pages.dev';
const url = site + path;
// TODO before launch: replace placeholder phone/email with real ones (also in index.astro + llms.txt)
const email = 'hello@rr-electric.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14181d" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="R&R Electric" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={site + '/images/hero.jpg'} />
    <meta property="og:image:alt" content="Electrician using a drill on an indoor circuit breaker panel" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Electrician',
          '@id': site + '/#business',
          name: 'R&R Electric',
          description,
          url: site,
          telephone: '+1-256-555-0142',
          email,
          image: site + '/images/hero.jpg',
          logo: site + '/favicon.svg',
          address: { '@type': 'PostalAddress', addressLocality: 'Florence', addressRegion: 'AL', addressCountry: 'US' },
          geo: { '@type': 'GeoCoordinates', latitude: 34.7993, longitude: -87.6773 },
          areaServed: [
            { '@type': 'City', name: 'Florence, AL' },
            { '@type': 'City', name: 'Muscle Shoals, AL' },
            { '@type': 'City', name: 'Sheffield, AL' },
            { '@type': 'City', name: 'Tuscumbia, AL' },
            { '@type': 'City', name: 'Killen, AL' },
            { '@type': 'City', name: 'Russellville, AL' },
          ],
          openingHoursSpecification: [{
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            opens: '07:00', closes: '18:00',
          }],
          priceRange: '$$',
          serviceType: ['Panel upgrades', 'Whole-home rewiring', 'EV charger installation', 'Lighting installation', 'Electrical repair', 'Surge protection', 'Code corrections'],
          knowsAbout: ['Panel upgrades', 'Whole-home rewiring', 'EV charger installation', 'Lighting installation', 'Electrical repair', 'Surge protection', 'Code corrections'],
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Electrical services',
            itemListElement: [
              'Panel upgrades', 'Whole-home rewiring', 'EV charger installation', 'Lighting & ceiling fans',
              'Repairs & troubleshooting', 'Surge protection', 'Remodels & additions', 'Code corrections & inspections',
            ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
          },
        },
        {
          '@type': 'WebSite',
          '@id': site + '/#website',
          url: site,
          name: 'R&R Electric',
          publisher: { '@id': site + '/#business' },
        },
        {
          '@type': 'WebPage',
          '@id': url,
          url,
          name: title,
          description,
          isPartOf: { '@id': site + '/#website' },
          about: { '@id': site + '/#business' },
        },
      ],
    })} />

    <script>document.documentElement.classList.add('js');</script>
    <style is:global>@import '../styles/global.css';</style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script src="../scripts/site.js"></script>
  </body>
</html>
